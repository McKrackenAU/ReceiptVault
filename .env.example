# ReceiptVault environment template.
# Copy to /etc/receiptvault/receiptvault.env on production (root:root, mode 0600)
# or to .env for local development. Never commit real secrets.

# --- Core ---
# Environment: local | production
RECEIPTVAULT_ENV=local
RECEIPTVAULT_APP_VERSION=1.5.0
# Public origin used for OAuth callbacks and CSRF (no trailing slash)
RECEIPTVAULT_PUBLIC_URL=http://127.0.0.1:8473
RECEIPTVAULT_API_HOST=127.0.0.1
RECEIPTVAULT_API_PORT=8473
RECEIPTVAULT_TIMEZONE=Australia/Melbourne
RECEIPTVAULT_LOG_LEVEL=INFO

# 32+ byte URL-safe master key. Encrypts mailbox refresh tokens at rest.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
RECEIPTVAULT_MASTER_KEY=

# Session cookie lifetime in seconds (default 12 hours)
RECEIPTVAULT_SESSION_SECONDS=43200
# Set true when served over HTTPS (Cloudflare Tunnel)
RECEIPTVAULT_COOKIE_SECURE=false
# Comma-separated CIDRs/IPs whose X-Forwarded-* headers are trusted
RECEIPTVAULT_TRUSTED_PROXIES=

# --- Database ---
# postgresql+psycopg://user:pass@host:5432/receiptvault
RECEIPTVAULT_DATABASE_URL=postgresql+psycopg://receiptvault:receiptvault_dev@127.0.0.1:5432/receiptvault

# --- Queue ---
RECEIPTVAULT_REDIS_URL=redis://127.0.0.1:6379/0

# --- Storage ---
# Content-addressed originals. Must remain writable by the service user.
RECEIPTVAULT_EVIDENCE_ROOT=./var/evidence
RECEIPTVAULT_DERIVED_ROOT=./var/derived
RECEIPTVAULT_STAGING_ROOT=./var/staging
RECEIPTVAULT_BACKUP_ROOT=./var/backups
RECEIPTVAULT_SOFT_DELETE_DAYS=30

# --- Transfers (Cloudflare-safe chunks) ---
# Default 16 MiB; allowed range 5–50 MiB. Stay below proxy body limits (100 MB Free/Pro).
RECEIPTVAULT_CHUNK_SIZE_MIB=16
RECEIPTVAULT_MAX_UPLOAD_MIB=4096
RECEIPTVAULT_TRANSFER_SESSION_HOURS=24
RECEIPTVAULT_PACKAGE_EXPIRY_HOURS=48

# --- Microsoft identity / Graph ---
# Entra application (client) ID and secret from the app registration walkthrough.
RECEIPTVAULT_MS_CLIENT_ID=
RECEIPTVAULT_MS_CLIENT_SECRET=
RECEIPTVAULT_MS_TENANT=common
RECEIPTVAULT_MS_REDIRECT_PATH=/api/v1/mail/oauth/callback
# Development/tests only. Never enable in production.
RECEIPTVAULT_GRAPH_MOCK=false

# --- Optional AI provider (disabled unless explicitly enabled) ---
RECEIPTVAULT_AI_ENABLED=false
RECEIPTVAULT_AI_PROVIDER=
RECEIPTVAULT_AI_ENDPOINT=
RECEIPTVAULT_AI_MODEL=

# --- Telemetry: off unless the owner opts in ---
RECEIPTVAULT_TELEMETRY_OPT_IN=false

# --- Rate limits ---
RECEIPTVAULT_LOGIN_RATE_PER_MINUTE=8
